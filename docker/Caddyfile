# Doctorek — reverse proxy + TLS automatique (Let's Encrypt)
# DOMAIN vient de l'environnement du conteneur caddy.

app.{$DOMAIN} {
	reverse_proxy frontend:3000
	header {
		# Transport + MIME
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Anti-clickjacking (doublé par frame-ancestors dans la CSP)
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Périphériques : géoloc autorisée pour la recherche "près de moi"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# CSP : 'unsafe-inline'/'unsafe-eval' requis par Next.js (scripts inline hydratation).
		# img-src https: pour les tuiles OpenStreetMap (Leaflet). Durcir avec nonces plus tard.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.{$DOMAIN} https://auth.{$DOMAIN} wss://api.{$DOMAIN} https://*.tile.openstreetmap.org; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://auth.{$DOMAIN}"
	}
}

api.{$DOMAIN} {
	reverse_proxy app:8080
	# En-têtes de sécurité API
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Resource-Policy "same-site"
	}
}

auth.{$DOMAIN} {
	reverse_proxy keycloak:8080
}

sonar.{$DOMAIN} {
	reverse_proxy sonarqube:9000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
}
