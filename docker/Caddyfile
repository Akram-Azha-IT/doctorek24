# Doctorek — reverse proxy + TLS automatique (Let's Encrypt)
# DOMAIN vient de l'environnement du conteneur caddy.

app.{$DOMAIN} {
	reverse_proxy frontend:3000
	header {
		# Transport + MIME
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Anti-clickjacking (doublé par frame-ancestors dans la CSP)
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Périphériques : géoloc autorisée pour la recherche "près de moi"
		# microphone=(self) : requis pour les messages vocaux (getUserMedia). camera reste bloquée.
		Permissions-Policy "camera=(), microphone=(self), geolocation=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# La CSP est désormais posée par Next.js (proxy.ts) avec un nonce par requête
		# — impossible à générer ici, statiquement. Voir doctorek-frontend/proxy.ts.
	}
}

api.{$DOMAIN} {
	reverse_proxy app:8080
	# En-têtes de sécurité API
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Resource-Policy "same-site"
	}
}

auth.{$DOMAIN} {
	reverse_proxy keycloak:8080
}

sonar.{$DOMAIN} {
	reverse_proxy sonarqube:9000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
}
