# ── Doctorek — environment template ─────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL
POSTGRES_DB=doctorek_db
POSTGRES_USER=doctorek_user
POSTGRES_PASSWORD=change-me-strong-password

# Keycloak
# Admin console password (docker-compose falls back to "admin" — change it!)
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-password
# Client secret of the confidential "doctorek-admin-cli" client
# (Keycloak → realm doctorek → Clients → doctorek-admin-cli → Credentials)
KEYCLOAK_ADMIN_CLIENT_SECRET=

# MinIO (file storage — dossier module)
MINIO_ROOT_USER=doctorek
MINIO_ROOT_PASSWORD=change-me-strong-password

# ── Production only ──────────────────────────────────────────────
# Carte virtuelle encryption key: 32 random bytes, base64
#   openssl rand -base64 32
# VMC_ENCRYPTION_KEY=

# Google Wallet (optional)
# GOOGLE_WALLET_ENABLED=false
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SA_PATH=
# GOOGLE_WALLET_HERO_SECRET=

# Assistant IA (module agent, optionnel)
# Les deux variables vont ensemble : poser le commutateur sans la cle
# fait echouer le demarrage de l'application.
# Cle gratuite : https://aistudio.google.com/apikey
# SPRING_AI_MODEL_CHAT=google-genai
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# SMTP (production mail — dev uses MailHog)
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@doctorek.ma
