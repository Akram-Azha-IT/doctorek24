# ── Doctorek — production (.env.prod) ────────────────────────────
# Copier en .env.prod sur le serveur. NE JAMAIS COMMITER.

# Domaine racine — les sous-domaines app./api./auth. doivent pointer vers le VPS
DOMAIN=doctorek.example.com

# PostgreSQL
POSTGRES_DB=doctorek_db
POSTGRES_USER=doctorek_user
POSTGRES_PASSWORD=

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# MinIO
MINIO_ROOT_USER=doctorek
MINIO_ROOT_PASSWORD=

# Chiffrement carte virtuelle : openssl rand -base64 32
VMC_ENCRYPTION_KEY=

# Auth.js : npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET=

# SMTP Brevo
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=b192e1001@smtp-brevo.com
MAIL_PASSWORD=
MAIL_FROM=akramya2002@gmail.com
